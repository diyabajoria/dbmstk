# MongoDB Atlas connection string (never commit the real .env file)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/household_inventory

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# Load a sample household automatically when the database is empty (true/false)
AUTO_SEED=true
